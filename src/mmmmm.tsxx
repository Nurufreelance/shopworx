src/components/dashboard/charts/OEEGauge.tsx:

typescript
import { designSystem } from '@theme/design-system';

interface OEEGaugeProps {
  value: number;
  label?: string;
  size?: 'sm' | 'md' | 'lg';
  maxValue?: number;
}

export const OEEGauge = ({ 
  value, 
  label = 'OEE', 
  size = 'lg',
  maxValue = 100 
}: OEEGaugeProps) => {
  const percentage = Math.min((value / maxValue) * 100, 100);
  const circumference = 2 * Math.PI * 45;
  const offset = circumference - (percentage / 100) * circumference;

  const getColor = (val: number) => {
    if (val >= 85) return '#31B86A';
    if (val >= 60) return '#F4A62A';
    return '#EF5350';
  };

  const sizes = {
    sm: { container: 'w-32 h-32', text: 'text-xl' },
    md: { container: 'w-40 h-40', text: 'text-2xl' },
    lg: { container: 'w-48 h-48', text: 'text-3xl' },
  };

  return (
    <div className={`${sizes[size].container} relative`}>
      <svg className="w-full h-full transform -rotate-90">
        {/* Background circle */}
        <circle
          cx="50%"
          cy="50%"
          r="45"
          fill="none"
          stroke="#E5E7EB"
          strokeWidth="8"
        />
        {/* Progress circle */}
        <circle
          cx="50%"
          cy="50%"
          r="45"
          fill="none"
          stroke={getColor(value)}
          strokeWidth="8"
          strokeDasharray={circumference}
          strokeDashoffset={offset}
          strokeLinecap="round"
          className="transition-all duration-500"
        />
      </svg>
      <div className="absolute inset-0 flex flex-col items-center justify-center">
        <span className={`font-bold text-[#1A1A2E] ${sizes[size].text}`}>
          {value}%
        </span>
        <span className="text-[10px] text-[#6B7280] uppercase tracking-wider">
          {label}
        </span>
      </div>
    </div>
  );
};
Step 4: Create OEE Metrics Card
src/components/dashboard/cards/OEEMetricsCard.tsx:

typescript
import { OEEMetrics } from '@types/dashboard/oee.types';

interface OEEMetricsCardProps {
  metrics: OEEMetrics;
  shift: 'A' | 'B' | 'C';
}

export const OEEMetricsCard = ({ metrics, shift }: OEEMetricsCardProps) => {
  const metricItems = [
    { label: 'OEE', value: metrics.oee, color: '#2F6BFF' },
    { label: 'Availability', value: metrics.availability, color: '#31B86A' },
    { label: 'Performance', value: metrics.performance, color: '#F4A62A' },
    { label: 'Quality', value: metrics.quality, color: '#EF5350' },
  ];

  return (
    <div className="shopworx-card">
      <div className="flex items-center justify-between mb-4">
        <h3 className="text-[13px] font-medium text-[#1A1A2E]">
          Shift {shift} OEE
        </h3>
        <span className="text-[10px] text-[#6B7280] uppercase tracking-wider">
          Today
        </span>
      </div>
      <div className="grid grid-cols-2 gap-4">
        {metricItems.map((item) => (
          <div key={item.label} className="text-center">
            <div className="text-[20px] font-bold" style={{ color: item.color }}>
              {item.value}%
            </div>
            <div className="text-[10px] text-[#6B7280] uppercase tracking-wider">
              {item.label}
            </div>
          </div>
        ))}
      </div>
    </div>
  );
};
Step 5: Create Availability Comparison Chart
src/components/dashboard/charts/AvailabilityComparisonChart.tsx:

typescript
import { designSystem } from '@theme/design-system';

interface AvailabilityComparisonChartProps {
  labels: string[];
  datasets: {
    label: string;
    data: number[];
    backgroundColor: string;
  }[];
  height?: number;
}

export const AvailabilityComparisonChart = ({
  labels,
  datasets,
  height = 300,
}: AvailabilityComparisonChartProps) => {
  const maxValue = Math.max(
    ...datasets.flatMap(d => d.data),
    100
  );

  return (
    <div className="shopworx-chart-container">
      <h3 className="shopworx-chart-title">Availability Comparison</h3>
      <div className="relative" style={{ height }}>
        <div className="absolute inset-0 flex items-end">
          {labels.map((label, index) => {
            const values = datasets.map(d => d.data[index] || 0);
            const maxValueForBar = Math.max(...values, 1);
            const totalHeight = (maxValueForBar / maxValue) * height * 0.9;

            return (
              <div key={index} className="flex-1 flex flex-col items-center h-full">
                <div className="relative w-full flex-1 flex items-end justify-center gap-1">
                  {datasets.map((dataset, dIndex) => {
                    const barHeight = (dataset.data[index] || 0) / maxValue * height * 0.9;
                    return (
                      <div
                        key={`${index}-${dIndex}`}
                        className="w-2 rounded-t transition-all duration-500"
                        style={{
                          height: `${barHeight}px`,
                          backgroundColor: dataset.backgroundColor,
                          opacity: 0.8,
                        }}
                      />
                    );
                  })}
                </div>
                <span className="text-[8px] text-[#6B7280] mt-1 transform rotate-45 origin-left">
                  {label}
                </span>
              </div>
            );
          })}
        </div>
      </div>
      {/* Legend */}
      <div className="flex justify-center gap-4 mt-4">
        {datasets.map((dataset) => (
          <div key={dataset.label} className="flex items-center gap-1.5">
            <div
              className="w-3 h-0.5 rounded"
              style={{ backgroundColor: dataset.backgroundColor }}
            />
            <span className="text-[10px] text-[#6B7280]">{dataset.label}</span>
          </div>
        ))}
      </div>
    </div>
  );
};
Step 6: Create the Shift OEE Page
src/features/oee/pages/ShiftOEE.tsx:

typescript
import { useState } from 'react';
import { PageLayout } from '@components/layout/PageLayout';
import { OEEGauge } from '@components/dashboard/charts/OEEGauge';
import { OEEMetricsCard } from '@components/dashboard/cards/OEEMetricsCard';
import { AvailabilityComparisonChart } from '@components/dashboard/charts/AvailabilityComparisonChart';
import { mockShiftOEEData, mockAvailabilityComparison } from '@mocks/oee.mock';

export default function ShiftOEE() {
  const [selectedShift, setSelectedShift] = useState<'A' | 'B' | 'C'>('A');
  const currentData = mockShiftOEEData[selectedShift];

  return (
    <PageLayout title="Shift OEE">
      {/* Shift Selector */}
      <div className="flex gap-2 mb-6">
        {(['A', 'B', 'C'] as const).map((shift) => (
          <button
            key={shift}
            onClick={() => setSelectedShift(shift)}
            className={`px-4 py-1.5 rounded-[8px] text-[11px] font-medium transition-colors ${
              selectedShift === shift
                ? 'bg-[#2F6BFF] text-white'
                : 'bg-white border border-[#E5E7EB] text-[#6B7280] hover:bg-gray-50'
            }`}
          >
            Shift {shift}
          </button>
        ))}
      </div>

      {/* OEE Gauge & Metrics */}
      <div className="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-6">
        <div className="shopworx-card flex items-center justify-center">
          <OEEGauge value={currentData.metrics.oee} label="OEE" size="lg" />
        </div>
        <OEEMetricsCard metrics={currentData.metrics} shift={selectedShift} />
      </div>

      {/* Availability Comparison Chart */}
      <div className="mb-6">
        <AvailabilityComparisonChart
          labels={mockAvailabilityComparison.labels}
          datasets={mockAvailabilityComparison.datasets}
          height={350}
        />
      </div>

      {/* Machine Details Table */}
      <div className="shopworx-card">
        <div className="flex items-center justify-between mb-4">
          <h3 className="text-[13px] font-medium text-[#1A1A2E]">
            Machine Availability Details
          </h3>
          <span className="text-[10px] text-[#6B7280]">
            {currentData.machineAvailabilities.length} machines
          </span>
        </div>
        <div className="overflow-x-auto">
          <table className="shopworx-table">
            <thead>
              <tr>
                <th>Machine</th>
                <th>Availability</th>
                <th>Shift</th>
                <th>Date</th>
              </tr>
            </thead>
            <tbody>
              {currentData.machineAvailabilities.slice(0, 10).map((machine) => (
                <tr key={machine.machineId}>
                  <td className="font-medium">{machine.machineName}</td>
                  <td>
                    <div className="flex items-center gap-2">
                      <div className="flex-1 max-w-[100px]">
                        <div className="w-full bg-[#E5E7EB] rounded-full h-1.5">
                          <div
                            className="h-1.5 rounded-full transition-all duration-500"
                            style={{
                              width: `${machine.availability}%`,
                              backgroundColor: machine.availability >= 70 ? '#31B86A' : '#F4A62A',
                            }}
                          />
                        </div>
                      </div>
                      <span className="text-[11px] font-medium">
                        {machine.availability}%
                      </span>
                    </div>
                  </td>
                  <td>Shift {machine.shift}</td>
                  <td className="text-[#6B7280]">{machine.date}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </PageLayout>
  );
}
